__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
.env
*.secret
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
CLAUDE.md
CLAUDE.local.md
# .claude/settings.json IS tracked on purpose -- it carries the public docs MCP
# entry and nothing machine-specific. The .local. variant is where per-machine
# settings go (Bedrock region, model pins, tool permissions), so it must not be.
.claude/settings.local.json
# Backups of the above. .gitignore matches exact names, so CLAUDE.local.md.bak was
# NOT covered and sat untracked in a public checkout carrying the ClientId, tenant
# names and customer findings -- one `git add -A` from being staged. Backups recur,
# so this is a rule rather than a habit.
*.bak
*.orig
*-prompt.md
reports/*.html
reports/*.json
/_logo_b64.txt
*.converted.json
sademodev22-*.html
test_results.txt

# --- Local working artifacts, 2026-08-14 -------------------------------------
# ~35 untracked files were sitting in this checkout with no rule covering them:
# command references as .docx, a personal feedback .xlsx, Grafana dashboard JSON,
# one-off probe scripts, and a LogRhythm PowerShell tool that belongs to a
# different product entirely. One `git add .` publishes all of it. Same failure as
# the *.bak rule above -- an untracked file in a public checkout is one careless
# stage away from being a published file.
#
# NOTE: scripts/ is deliberately NOT ignored -- gen_api_kb.py and
# sanitize_audit_artifact.py are meant to be tracked.
*.docx
*.xlsx
*.ps1
probe_*.py
probe_*.md
probe_output/
_tmp_*.md
_tier1_parts.txt
verify_api.py
full_audit.py
build_inventory.py
show_help.py
api-audit-new-findings.json
ng-beam-*.json

# Tenant data pulled into the checkout by a CLI run. This is a PUBLIC repo:
# alert, case, rule and zone exports are live customer data and must never be
# committed. Keep them outside the checkout -- C:\Users\<you>\ExaData on Windows.
# These patterns are a backstop, not the control.
*_alerts_*.json
*_cases_*.json
*_enabled_rules.csv
zones-*.csv
zones-*.json
tests/*.csv
tests/*.json